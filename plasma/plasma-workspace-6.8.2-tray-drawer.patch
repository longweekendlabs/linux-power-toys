diff --git a/applets/systemtray/qml/DrawerDropTarget.qml b/applets/systemtray/qml/DrawerDropTarget.qml
new file mode 100644
index 0000000..18fb8a8
--- /dev/null
+++ b/applets/systemtray/qml/DrawerDropTarget.qml
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: LGPL-2.0-or-later
+import QtQuick
+import org.kde.kirigami as Kirigami
+
+DropArea {
+    id: target
+    required property string mimeType
+    keys: [mimeType]
+
+    signal dragAccepted()
+    signal moveRequested()
+
+    function matches(event) {
+        // Fetching payload bytes here blocks Qt Wayland while it waits for
+        // the source, which runs on this same GUI thread.
+        return mimeType !== "" && event.formats.includes(mimeType);
+    }
+
+    onEntered: event => {
+        if (matches(event)) {
+            dragAccepted();
+        } else {
+            event.accepted = false;
+        }
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        anchors.margins: 1
+        visible: target.containsDrag
+        color: Qt.alpha(Kirigami.Theme.highlightColor, 0.15)
+        border.color: Kirigami.Theme.highlightColor
+        radius: 4
+    }
+
+    onDropped: drop => {
+        if (matches(drop)) {
+            drop.accept(Qt.MoveAction);
+            moveRequested();
+        }
+    }
+}
