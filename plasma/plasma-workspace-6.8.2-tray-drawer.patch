+
+bool SystemTray::moveDrawerItem(const QString &itemId, bool toPanel, const QString &before)
+{
+    if (!drawerEnabled() || itemId.isEmpty() || itemId == before) {
+        return false;
+    }
+    auto *model = sortedSystemTrayModel();
+    const auto idRole = static_cast<int>(BaseModel::BaseRole::ItemId);
+    const auto statusRole = static_cast<int>(BaseModel::BaseRole::EffectiveStatus);
+    QStringList panel;
+    QStringList hidden;
+    bool found = false;
+    for (int row = 0; row < model->rowCount(); ++row) {
+        const auto index = model->index(row, 0);
+        const QString id = index.data(idRole).toString();
+        const auto status = index.data(statusRole).toInt();
+        if (id.isEmpty() || (status != Plasma::Types::ActiveStatus && status != Plasma::Types::PassiveStatus)) {
+            continue;
+        }
+        if (id == itemId) {
+            if (found) {
+                return false; // The shared placement ID cannot distinguish these items.
+            }
+            found = true;
+            continue;
+        }
+        (status == Plasma::Types::ActiveStatus ? panel : hidden).append(id);
+    }
+    if (!found) {
+        return false;
+    }
+
+    // Keep the automatic visibility of other icons. Store their relative
+    // ordering independently of the explicit overrides made by a drop.
+    QStringList placement;
+    auto &destination = toPanel ? panel : hidden;
+    if (!before.isEmpty() && !destination.contains(before)) {
+        return false;
+    }
+    destination.insert(before.isEmpty() ? destination.size() : destination.indexOf(before), itemId);
+    const auto &previous = m_settings->drawerPlacement();
+    QSet<QString> recorded;
+    const auto append = [&](const QStringList &ids) {
+        for (const auto &id : ids) {
+            if (recorded.contains(id)) {
+                continue;
+            }
+            recorded.insert(id);
+            const auto shown = u'+' + id;
+            const auto drawer = u'-' + id;
+            placement.append(id == itemId ? (toPanel ? shown : drawer)
+                                          : previous.contains(shown) ? shown
+                                          : previous.contains(drawer) ? drawer : u'=' + id);
+        }
+    };
+    append(panel);
+    append(hidden);
+    for (const auto &entry : previous) {
+        if (!entry.isEmpty() && !recorded.contains(entry.mid(1))) {
+            placement.append(entry);
+        }
+    }
+    m_settings->setDrawerPlacement(placement);
+    return true;
+}
